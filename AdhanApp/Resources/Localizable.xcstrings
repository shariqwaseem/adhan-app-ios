    "Alarm ID" : {

    },
    "Alarm mode plays the full adhan sound and bypasses Silent Mode." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع التنبيه يشغل صوت الأذان الكامل ويتجاوز الوضع الصامت."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode alarm memutar suara adzan penuh dan mengabaikan Mode Senyap."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm modu tam ezan sesini çalar ve Sessiz Modu devre dışı bırakır."
          }
        }
      }
    },
    "Alarm mode plays the full adhan sound and bypasses Silent Mode. Requires Alarm permission." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع التنبيه يشغل صوت الأذان الكامل ويتجاوز الوضع الصامت. يتطلب إذن التنبيه."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode alarm memutar suara adzan penuh dan mengabaikan Mode Senyap. Memerlukan izin Alarm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm modu tam ezan sesini çalar ve Sessiz Modu devre dışı bırakır. Alarm izni gerektirir."
          }
        }
      }
    },
    "Alarm mode requires iOS 26 or later. Please update your device to use this feature." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع التنبيه يتطلب iOS 26 أو أحدث. يرجى تحديث جهازك لاستخدام هذه الميزة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode alarm memerlukan iOS 26 atau lebih baru. Silakan perbarui perangkat Anda untuk menggunakan fitur ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarm modu iOS 26 veya üstünü gerektirir. Bu özelliği kullanmak için cihazınızı güncelleyin."
          }
        }
      }
    },
    "Alarm mode requires permission. " : {
      "localizations" : {
