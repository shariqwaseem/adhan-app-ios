    "Allow location access so Adhan can update prayer times after you travel to a new city. Your location stays on your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع ليتمكن أذان من تحديث أوقات الصلاة بعد سفرك إلى مدينة جديدة. يبقى موقعك على جهازك."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses lokasi agar Adhan dapat memperbarui waktu sholat setelah Anda bepergian ke kota baru. Lokasi Anda tetap berada di perangkat Anda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir şehre seyahat ettikten sonra Adhan'ın namaz vakitlerini güncelleyebilmesi için konum erişimine izin verin. Konumunuz cihazınızda kalır."
          }
        }
      }
    },
