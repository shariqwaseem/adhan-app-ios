    "This app supports full-length alarms and adhan sounds that play even when your phone is on silent or in Focus mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدعم هذا التطبيق تنبيهات كاملة وأصوات أذان تعمل حتى عندما يكون هاتفك على الوضع الصامت أو في وضع التركيز."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini mendukung alarm dan suara adzan penuh yang berbunyi bahkan saat ponsel Anda dalam mode senyap atau mode Fokus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
