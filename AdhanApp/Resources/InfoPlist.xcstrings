            "state" : "translated",
            "value" : "أذان"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezan"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adhan alarm app"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم أذان التنبيهات لإعلامك بأوقات الصلاة، حتى عندما يكون هاتفك على الوضع الصامت أو في وضع التركيز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan uses alarms to alert you for prayer times, even when your phone is on silent or in Focus mode."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan menggunakan alarm untuk mengingatkan Anda waktu sholat, bahkan saat ponsel dalam mode senyap atau mode Fokus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, telefonunuz sessiz modda veya Odaklanma modunda olsa bile namaz vakitlerinde sizi uyarmak için alarm kullanır."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم أذان نطاق سفر بمسافة 25 كم على جهازك في الخلفية لتحديث أوقات الصلاة بعد انتقالك إلى منطقة جديدة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan uses an on-device 25 km travel boundary in the background to update prayer times after you travel to a new area."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan menggunakan batas perjalanan 25 km di perangkat Anda di latar belakang untuk memperbarui waktu sholat setelah Anda bepergian ke area baru."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, yeni bir bölgeye seyahat ettiğinizde namaz vakitlerini güncellemek için cihazınızda arka planda 25 km'lik bir seyahat sınırı kullanır."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج أذان إلى موقعك لحساب أوقات الصلاة الدقيقة لمنطقتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan needs your location to calculate accurate prayer times for your area."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan memerlukan lokasi Anda untuk menghitung waktu sholat yang akurat untuk daerah Anda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, bölgeniz için doğru namaz vakitlerini hesaplamak için konumunuza ihtiyaç duyar."
          }
        }
      }
    },
    "NSSiriUsageDescription" : {
      "comment" : "Privacy - Siri Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم أذان Siri للإجابة عن أسئلة أوقات الصلاة، مثل: \"ما وقت الصلاة التالية في أذان؟\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan uses Siri to answer prayer time questions, for example, \"What time is the next prayer in Adhan?\""
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan menggunakan Siri untuk menjawab pertanyaan waktu sholat, misalnya, \"Jam berapa waktu sholat berikutnya di Adhan?\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adhan, Siri ile namaz vakti sorularını yanıtlar; örneğin: \"Ezan'da bir sonraki namaz vakti ne zaman?\""
          }
        }
      }
    }
  },
  "version" : "1.0"
}
