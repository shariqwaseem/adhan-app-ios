require_relative "snapshot_compatibility"

default_platform(:ios)

platform :ios do
  desc "Capture localized App Store screenshots"
  lane :screenshots do |options|
    capture_screenshots(
      languages: options[:languages]
    )
  end

  desc "Capture screenshots and add localized captions and device frames"
  lane :screenshots_framed do |options|
    capture_screenshots(
      languages: options[:languages]
    )
    sh("python3 reshape_arabic.py")
    begin
      frame_screenshots(
        path: "./fastlane/screenshots",
        use_platform: "IOS"
      )
    ensure
      sh("python3 reshape_arabic.py restore")
    end
  end

  desc "Frame existing screenshots with Arabic shaping support"
  lane :frame do |options|
    sh("python3 reshape_arabic.py")
    begin
      frame_screenshots(
        path: options[:path] || "./fastlane/screenshots",
        use_platform: options[:use_platform] || "IOS"
      )
    ensure
      sh("python3 reshape_arabic.py restore")
    end
  end
end
